class GameEngine {
public:
    void optimize_game_session(std::string game_name, bool is_low_end) {
        if (game_name == "GenshinImpact" || game_name == "HonkaiStarRail") {
            apply_rpg_optimization(is_low_end);
        } else if (game_name == "HOK" || game_name == "ArenaOfValor") {
            apply_moba_optimization(is_low_end);
        }
    }

private:
    void apply_rpg_optimization(bool low_end) {
        if (low_end) {
            // Ép xung GPU nhẹ và giảm độ phân giải nội bộ (Internal Resolution)
            system("export DXVK_CONFIG=\"d3d11.maxTessellationFactor = 8\"");
            system("export FSR_STRENGTH=2"); // Kích hoạt siêu mẫu AMD FSR
        } else {
            // Máy mạnh: Kích hoạt Shader Pre-caching để triệt tiêu khựng hình
            system("export __GL_SHADER_DISK_CACHE=1");
            system("export __GL_SHADER_DISK_CACHE_SIZE=1073741824");
        }
    }

    void apply_moba_optimization(bool low_end) {
        // Ưu tiên độ trễ mạng (Ping) lên hàng đầu
        system("sudo tc qdisc add dev eth0 root fq_codel"); // Thuật toán giảm nghẽn mạng
        system("sysctl -w net.ipv4.tcp_low_latency=1");
    }
};
