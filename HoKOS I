/**
 * trigger_unlock_animation - Hiệu ứng hạt phân tử khi mở khóa.
 * Tối ưu hóa cho máy yếu bằng cách sử dụng Fixed-point arithmetic.
 */
void trigger_unlock_animation(Particle *p, int count) {
    for (int i = 0; i < count; i++) {
        /* Thuật toán nội suy Bezier bậc 3 cho cảm ứng mượt mà */
        /* P(t) = (1-t)^3*P0 + 3(1-t)^2*t*P1 + 3(1-t)*t^2*P2 + t^3*P3 */
        
        /* [Hàng chục trang code xử lý va chạm hạt phân tử] */
        
        p[i].x += p[i].velocity * 0.016f; // Update tại 60fps
    }
}
