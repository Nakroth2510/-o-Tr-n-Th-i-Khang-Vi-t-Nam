    /* Khóa trang bộ nhớ để không bị swap ra ổ cứng, tăng tốc độ truy cập */
    if (mlock(addr, size) != 0) {
        return -1; // Early exit: Bảo mật vùng nhớ thất bại
    }
    return 0;
}

